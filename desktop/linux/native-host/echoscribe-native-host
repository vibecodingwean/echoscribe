#!/bin/sh
set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
python_bin="${ECHOSCRIBE_PYTHON:-$root/.venv/bin/python}"
if [ ! -x "$python_bin" ]; then
  python_bin="/usr/bin/python3"
fi
if [ ! -x "$python_bin" ]; then
  python_bin="$(command -v python3)"
fi

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
log_dir="$state_home/echoscribe"
log_file="$log_dir/native-host.log"
mkdir -p "$log_dir" 2>/dev/null || true
{
  printf '%s native-host start root=%s python=%s PATH=%s\n' "$(date -Is 2>/dev/null || date)" "$root" "$python_bin" "${PATH:-}"
} >>"$log_file" 2>/dev/null || true

if [ -n "${PYTHONPATH:-}" ]; then
  export PYTHONPATH="$root:$PYTHONPATH"
else
  export PYTHONPATH="$root"
fi

exec "$python_bin" -m echoscribe native-host 2>>"$log_file"
