<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.echoscribe" path="/org/gnome/shell/extensions/echoscribe/">
    <key name="enabled" type="b">
      <default>true</default>
      <summary>Enable EchoScribe controls</summary>
    </key>
    <key name="toggle-shortcut" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;a']</default>
      <summary>Hold-to-talk shortcut</summary>
    </key>
    <key name="repo-path" type="s">
      <default>''</default>
      <summary>EchoScribe repository path</summary>
    </key>
    <key name="python-path" type="s">
      <default>''</default>
      <summary>Python executable</summary>
    </key>
    <key name="feedback-mode" type="s">
      <default>'shell'</default>
      <summary>Feedback mode</summary>
      <description>One of 'shell', 'legacy', or 'notifications'. PTT input is always active.</description>
    </key>
    <key name="trigger-mode" type="s">
      <default>'ptt'</default>
      <summary>Deprecated compatibility key</summary>
    </key>
    <key name="worker-command" type="s">
      <default>''</default>
      <summary>Deprecated compatibility key</summary>
    </key>
    <key name="show-notifications" type="b">
      <default>true</default>
      <summary>Deprecated compatibility key</summary>
    </key>
    <key name="shell-widget-feedback" type="b">
      <default>true</default>
      <summary>Deprecated compatibility key</summary>
    </key>
    <key name="floating-sideband" type="b">
      <default>false</default>
      <summary>Deprecated compatibility key</summary>
    </key>
  </schema>
</schemalist>

