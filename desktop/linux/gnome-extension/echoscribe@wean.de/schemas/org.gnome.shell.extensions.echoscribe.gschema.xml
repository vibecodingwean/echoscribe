<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.echoscribe" path="/org/gnome/shell/extensions/echoscribe/">
    <key name="enabled" type="b">
      <default>true</default>
      <summary>Enable EchoScribe controls</summary>
    </key>
    <key name="toggle-shortcut" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;a']</default>
      <summary>Start/stop dictation shortcut</summary>
    </key>
    <key name="echoscribe-toggle-shortcut" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;a']</default>
      <summary>Internal namespaced start/stop keybinding</summary>
      <description>Mirrors toggle-shortcut while providing Mutter with a globally unique binding name.</description>
    </key>
    <key name="echoscribe-ptt-shortcut" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;a']</default>
      <summary>Deprecated internal keybinding migration alias</summary>
      <description>Retained temporarily so a cached pre-toggle extension remains loadable until logout.</description>
    </key>
    <key name="install-path" type="s">
      <default>''</default>
      <summary>EchoScribe Linux application path</summary>
    </key>
    <key name="python-path" type="s">
      <default>''</default>
      <summary>Python executable</summary>
    </key>
    <key name="feedback-mode" type="s">
      <default>'shell'</default>
      <summary>Feedback mode</summary>
      <description>One of 'shell' or 'notifications'. The dictation shortcut toggles recording.</description>
    </key>
  </schema>
</schemalist>
